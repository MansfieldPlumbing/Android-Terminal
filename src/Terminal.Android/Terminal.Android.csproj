<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>36.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <OutputType>Exe</OutputType>
    <RootNamespace>NativePwshConsole</RootNamespace>
    <AssemblyName>Terminal</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>dev.mansfieldplumbing.terminal</ApplicationId>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableEventPipe>false</EnableEventPipe>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <LatestSupportedJavaVersion>25.0.99</LatestSupportedJavaVersion>
    <JavacSourceVersion>11</JavacSourceVersion>
    <JavacTargetVersion>11</JavacTargetVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Terminal.Engine\Terminal.Engine.csproj" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.7.0-preview.2">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <AndroidEnvironment Include="environment.txt" />
    <AndroidAsset Include="Assets\settings.ps1" />
    <AndroidAsset Include="Assets\System\*.ps1" Link="System\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
